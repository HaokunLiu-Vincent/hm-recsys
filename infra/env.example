# The names of the cloud project of stage 3 (docs/mlops.md §12; M13).
#
# Copy this file to infra/.env and fill in the first six values:
#
#     cp infra/env.example infra/.env
#
# infra/.env is ignored by git (.gitignore: ".env"). The repository is public: the real
# project id, bucket name and service-account addresses are written ONLY there, never in
# a tracked file, a commit message, a workflow file or a published log.

# ---- what exists already (created by hand before M13) -------------------------------

# The project id (not its number, not its display name).
PROJECT_ID=your-project-id
# One region for everything (docs/mlops.md decision D4).
REGION=us-central1
# The private bucket. Its dvc/ prefix is the DVC remote of M11 and is never touched.
BUCKET=your-bucket-name
# The account the coding agent works through, by impersonation, without a key file.
OPERATOR_SERVICE_ACCOUNT=operator-account@your-project-id.iam.gserviceaccount.com
# The GitHub repository that may push images, as owner/name.
GITHUB_REPOSITORY=owner/repository
# The address that receives the alert emails (M14). It is private like the names above.
ALERT_EMAIL=you@example.com

# ---- what infra/setup.sh creates (these names can stay as they are) ------------------

# The Docker repository in Artifact Registry and the name of the image in it.
ARTIFACT_REPOSITORY=hmrec
IMAGE_NAME=hmrec
# The three service accounts (the part before "@").
RUNTIME_SERVICE_ACCOUNT_NAME=hm-job-runtime
SCHEDULER_SERVICE_ACCOUNT_NAME=hm-scheduler
DEPLOYER_SERVICE_ACCOUNT_NAME=hm-deployer
# The custom role that holds the single permission "start a Cloud Run job".
JOB_STARTER_ROLE=hmJobStarter
# Workload Identity Federation for GitHub Actions.
WIF_POOL=github
WIF_PROVIDER=github-actions
# The runtime service account of the recommendation service (M14; the part before "@").
SERVICE_RUNTIME_SERVICE_ACCOUNT_NAME=hm-service-runtime
# The display name of the one email notification channel of the alert policies (M14).
ALERT_CHANNEL_NAME=hmrec-alerts

# ---- what the operator creates later with infra/operate.sh ---------------------------

# The Cloud Run job of the weekly pipeline and the Cloud Scheduler job that starts it.
JOB_NAME=hm-weekly
SCHEDULER_JOB_NAME=hm-weekly-tick
# The three prefixes of the bucket the job mounts (docs/mlops.md §7.2).
INPUTS_PREFIX=inputs
STATE_PREFIX=pipeline
# The Cloud Run service of the recommendation API (M14). The deploy workflow
# (.github/workflows/deploy.yml) updates the job and the service by these two names:
# if JOB_NAME or SERVICE_NAME is changed here, change it there too.
SERVICE_NAME=hm-recs
