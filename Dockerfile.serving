# The image of the recommendation service (docs/mlops.md §9; M14).
#
# Build it with `make service-image-build` (laptop) or by the deploy workflow (cloud),
# never with a bare `docker build`: both pass the commit, so that the image carries the
# commit it was built from.
#
# It holds ONLY what the service needs: Python, numpy, FastAPI, uvicorn and five source
# files. No torch, no LightGBM, no polars, no configs, no data. What may enter the build
# at all is listed in Dockerfile.serving.dockerignore (an allow-list of its own; Docker
# uses the ignore file named after the Dockerfile).
#
# Pinned like the pipeline image (Dockerfile): the base image and uv by digest, every
# Python package by uv.lock. The two FROM lines are the same as there.
FROM ghcr.io/astral-sh/uv:0.13.6@sha256:af22a52f5eafef3d78e551599d405c02df61919d18028f0cea8eda93bc9986d0 AS uv

FROM python:3.12.16-slim-trixie@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b

# The process does not run as root. The uid is the one of the pipeline image: the state
# is mounted with this uid (infra/operate.sh).
RUN useradd --create-home --uid 1000 --shell /bin/bash hmrec

WORKDIR /app

# uv: use the Python of the base image (never download one), copy packages into the
# environment and compile to bytecode at build time (/app is read-only for the user).
ENV UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_NO_CACHE=1

# The dependencies: ONLY the group `serving` of pyproject.toml (fastapi, uvicorn, numpy
# and what they need), exactly as uv.lock pins them. The project itself is not installed:
# that would bring torch and LightGBM. uv is mounted for this one step and is not part
# of the image.
COPY pyproject.toml uv.lock ./
RUN --mount=from=uv,source=/uv,target=/usr/local/bin/uv \
    uv sync --frozen --no-install-project --only-group serving

# The code: the package of the service and the two bottom-layer modules it imports.
COPY src/hmrec/__init__.py src/hmrec/serving_set.py src/hmrec/structured_logs.py src/hmrec/
COPY src/hmrec/serving/ src/hmrec/serving/

# The commit this image was built from. Required: without it the build stops here.
ARG GIT_COMMIT
RUN echo "${GIT_COMMIT}" | grep --quiet --extended-regexp '^[0-9a-f]{40}$' \
    || (echo "build with --build-arg GIT_COMMIT=\$(git rev-parse HEAD); use make service-image-build" >&2; exit 1)
LABEL org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.title="hmrec-serving" \
      org.opencontainers.image.description="H&M recommendation system: recommendation service (stage 3)"

# At run time:
#   HMREC_IMAGE_GIT_COMMIT       the commit of the image; /healthz shows it.
#   PYTHONPATH                   the code is used from /app/src; it is not installed.
#   PYTHONDONTWRITEBYTECODE      /app is read-only for the user.
#   PYTHONUNBUFFERED             a log line is written at once, not when a buffer is full.
# The service is told where the state is and how often to look at the pointer by the one
# who starts it (HMREC_SERVING_STATE_ROOT, HMREC_SERVING_POLL_SECONDS).
ENV HMREC_IMAGE_GIT_COMMIT="${GIT_COMMIT}" \
    PYTHONPATH=/app/src \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:${PATH}"

USER hmrec

# Fail the build if the service cannot be imported with what is in this image (a module
# that was not copied, a package that is not in the group).
RUN python -c "import hmrec.serving.app"

# Cloud Run sends requests to this port.
EXPOSE 8080

# --no-access-log: uvicorn's access log prints the path of a request, which holds the
# customer id. The service writes its own line per request, without it.
CMD ["uvicorn", "hmrec.serving.app:create_app_from_environment", "--factory", \
     "--host", "0.0.0.0", "--port", "8080", "--no-access-log"]
